#!/bin/sh
# .githooks/pre-push - run the gate (tools/gate.py) on the commits being pushed, 2026-11-02.
# ship-guard: gate   (the profile's hooks/ship_guard.py refuses a Claude session's push here while core.hooksPath is not .githooks)
#
# The gate is what CI's manual audit runs (ci.yml, dispatch only, on Linux and Windows PowerShell 5.1): the
# public-boundary check, the machine-paths guard, every test suite and the gitleaks secret scan. The automatic PR
# checks (secret-scan.yml, machine-paths.yml) fire only when a PR opens or leaves draft, so a failing test, a literal
# machine path, a private marker or a secret is caught here, on each push.
# The profile's bootstrap turns it on (tools/git_gate.py: gitleaks, then core.hooksPath = .githooks in this clone);
# by hand, once per clone:
#     git config core.hooksPath .githooks
#
# Behavior:
#   - What is checked, per pushed ref (2026-11-11, SA09-1: every pushed commit stays in the public history, so the
#     tip alone is not enough; a secret added in one commit and removed in the next was published unseen):
#       * the tip commit: the whole gate;
#       * every earlier commit the remote does not have yet: the publication scans only (`gate.py --scans-only`:
#         public-boundary check, machine-paths scan, secret scan), oldest first. No test suite runs on those: a red
#         test in an earlier commit is not a leak. The scans are run by the TIP's gate.py, with the TIP's scanners
#         and the TIP's allowlists (.machine-paths-allow.json, tools/public-boundary-exceptions.json,
#         tools/private-identifiers.sha256, .gitleaks.toml), never the earlier commit's own: scanned with its own,
#         a commit could except its own leak and a later commit could remove the exception again. So content that
#         needs an exception passes only when the exception is still in the tip, and an earlier commit that
#         predates `--scans-only` is still scanned.
#     "The remote does not have yet" = not reachable from the pushed ref's old value on the remote, nor from any of
#     this clone's remote-tracking refs for that remote (so commits merged in from the default branch are not
#     scanned again). A push to a bare URL has no tracking refs: every commit not under the old value is scanned.
#   - Each checked commit is checked out into a throwaway clone and checked there, from that commit, so the result is
#     the pushed tree's, never the working copy's: uncommitted edits neither fail nor pass a push.
#   - A failing step BLOCKS the push (exit 1); the gate prints that step's full output, the text CI prints. Every
#     commit is still checked, so one push shows every problem.
#   - A gate that cannot run (no Python 3.9+, the throwaway clone fails, the pushed tip has no tools/gate.py, the
#     pushed commits cannot be listed) also BLOCKS, naming why. A branch older than the gate: merge or rebase onto
#     the default branch first.
#   - Branch deletions are not checked.
#   - Timing: the gate takes about a minute for the tip, and each earlier commit adds a few seconds; give
#     `git push` a 5-minute timeout, more for a long first push.
#   - Emergency bypass, explicit and audited:  BIMP_PREPUSH_BYPASS="<reason>" git push ...
#     appends a line to <git-common-dir>/prepush-bypass.log. `--no-verify` skips the hook and leaves no trail.
#     Claude sessions can use neither (ship_guard refuses both); the owner's own terminal can.
# Python lookup: python3, python, then py -3; each is probed, so a store stub that fails is skipped.
# POSIX sh, LF endings.

GATE=tools/gate.py
remote=${1:-}

repo=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "pre-push: not inside a git work tree" >&2; exit 1; }
common=$(cd "$repo" && cd "$(git rev-parse --git-common-dir)" && pwd) || { echo "pre-push: cannot locate the git directory" >&2; exit 1; }

if [ -n "${BIMP_PREPUSH_BYPASS:-}" ]; then
    log="$common/prepush-bypass.log"
    printf '%s pre-push bypass: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$BIMP_PREPUSH_BYPASS" >> "$log"
    echo "pre-push: gate BYPASSED ($BIMP_PREPUSH_BYPASS) - logged to $log" >&2
    exit 0
fi

cannot_scan() {
    echo "pre-push: BLOCKED - the gate cannot run: $1" >&2
    echo "pre-push: emergency bypass (owner only, logged): BIMP_PREPUSH_BYPASS=\"<reason>\" git push ..." >&2
    exit 1
}

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per pushed ref.
targets=
while read -r lref lsha rref rsha; do
    case "$lsha" in *[!0]*) ;; *) continue ;; esac   # all zeros: a deletion, nothing to scan
    case "$targets" in *"$lsha"*) continue ;; esac
    targets="$targets$lsha $lref $rsha
"
done
[ -n "$targets" ] || exit 0

py= pyarg=
for c in python3 python py; do
    command -v "$c" >/dev/null 2>&1 || continue
    a=
    [ "$c" = py ] && a=-3
    if "$c" $a -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
        py=$c pyarg=$a
        break
    fi
done
[ -n "$py" ] || cannot_scan "no Python 3.9+ found (tried python3, python, py -3)"

# The throwaway clones are separate repositories; hook-time git variables would point them back here, and a
# `git -c ...` on the push (exported as GIT_CONFIG_*) would reach every git the gate's suites run.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
unset GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT

tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX") || cannot_scan "could not create a temporary directory"
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM

# Remote-tracking refs exist only for a configured remote name, never for a bare URL.
tracked=
if [ -n "$remote" ] && git -C "$repo" remote 2>/dev/null | grep -Fqx -- "$remote"; then
    tracked=1
fi

# checkout_commit <sha> <ref> <dir>: the commit, alone, in a throwaway clone.
checkout_commit() {
    { git clone -q --shared --no-checkout "$common" "$3" &&
      git -C "$3" -c advice.detachedHead=false checkout -q --detach "$1"; } </dev/null >/dev/null 2>&1 ||
        cannot_scan "could not check out $(printf '%s' "$1" | cut -c1-12) ($2) into a throwaway clone"
}

failed=0
scanned=
while read -r sha ref rsha; do
    [ -n "$sha" ] || continue
    short=$(printf '%s' "$sha" | cut -c1-12)
    tree="$tmp/$short"
    checkout_commit "$sha" "$ref" "$tree"
    [ -f "$tree/$GATE" ] ||
        cannot_scan "$short ($ref) has no $GATE - merge or rebase onto the default branch, then push again"

    # The commits this push publishes besides the tip, oldest first.
    old=
    case "$rsha" in
        *[!0]*) git -C "$repo" cat-file -e "$rsha^{commit}" 2>/dev/null && old="^$rsha" ;;
    esac
    if [ -n "$tracked" ]; then
        earlier=$(git -C "$repo" rev-list --reverse "$sha" $old --not --remotes="$remote" 2>/dev/null) ||
            cannot_scan "could not list the commits being pushed to $ref"
    else
        earlier=$(git -C "$repo" rev-list --reverse "$sha" $old 2>/dev/null) ||
            cannot_scan "could not list the commits being pushed to $ref"
    fi
    while read -r c; do
        [ -n "$c" ] || continue
        [ "$c" = "$sha" ] && continue                      # the tip gets the whole gate, below
        case "$scanned" in *"$c"*) continue ;; esac        # already scanned for another pushed ref
        scanned="$scanned$c "
        cshort=$(printf '%s' "$c" | cut -c1-12)
        ctree="$tmp/c-$cshort"
        checkout_commit "$c" "$ref" "$ctree"
        echo "pre-push: scanning $cshort ($ref), an earlier commit: boundary, machine paths, secrets" >&2
        (cd "$ctree" && "$py" $pyarg "$tree/$GATE" --scans-only --root .) </dev/null >&2
        rc=$?
        if [ "$rc" -ne 0 ]; then
            failed=1
            echo "pre-push: FAILED (exit $rc): python $GATE --scans-only  [$cshort, $ref]" >&2
        fi
        rm -rf "$ctree"
    done <<EOF
$earlier
EOF

    echo "pre-push: running the gate on $short ($ref)" >&2
    (cd "$tree" && "$py" $pyarg "$GATE" --root .) </dev/null >&2
    rc=$?
    if [ "$rc" -ne 0 ]; then
        failed=1
        echo "pre-push: FAILED (exit $rc): python $GATE  [$short, $ref]" >&2
    fi
    rm -rf "$tree"
done <<EOF
$targets
EOF

if [ "$failed" -ne 0 ]; then
    echo "pre-push: BLOCKED - CI's manual audit (ci.yml) runs this same gate and would fail the same way." >&2
    echo "pre-push: fix the failures above, commit, push again. A vetted exception goes in the scanner's" >&2
    echo "pre-push: allowlist (.machine-paths-allow.json, tools/public-boundary-exceptions.json, .gitleaks.toml), not a bypass." >&2
    echo "pre-push: a failure in an EARLIER commit stays in history: rewrite that commit (rebase or squash), then push again." >&2
    echo "pre-push: an earlier commit is scanned with the TIP's scanners and allowlists: an exception it needs must still be in the tip." >&2
    exit 1
fi
echo "pre-push: gate passed" >&2
exit 0
